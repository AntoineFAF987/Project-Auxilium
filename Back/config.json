{
  "index_dir": "./data/index_rag",
  "exclude_globs": [
    "*/data/index_rag/*",
    "*/data/emails_cache/*",
    "*/data/email_attachments/*"
  ],
  "follow_symlinks": false,
  "retrieval": {
    "embedding_model": "paraphrase-multilingual-mpnet-base-v2",
    "reranker_model": "BAAI/bge-reranker-v2-m3",
    "reranker_fallback": "cross-encoder/ms-marco-MiniLM-L-6-v2",
    "device": "auto",
    "retrieve_k": 12,
    "top_k_faiss": 100,
    "top_k_bm25": 100,
    "final_k": 10,
    "hybrid_alpha": 0.8,
    "exact_match_bonus": 0.15,
    "exact_match_min_chars": 6,
    "mmr_lambda": 0.7,
    "preliminary_pool_multiplier": 2,
    "normalize_embeddings": true,
    "max_context_chars": 12000,
    "fuse_adjacent_gap": 1
  },
  "graph": {
    "client_id": "9f9d4471-a297-4095-86ff-8af1173f700d",
    "authority": "https://login.microsoftonline.com/consumers",
    "scopes": [
      "https://graph.microsoft.com/User.Read",
      "https://graph.microsoft.com/Mail.Read"
    ]
  },
  "email_ingest": {
    "output_dir": "./data/emails_cache",
    "attachments_dir": "./data/email_attachments",
    "max_emails": 1000,
    "folders": [
      "Boîte de réception"
    ],
    "date_since": "2024-01-01T00:00:00Z",
    "include_body_html": false,
    "flatten_for_rag_dir": "./data/emails_flattened"
  },
  "rag_params": {
    "answerability_threshold": -0.5,
    "overlap_min": 1,
    "context_relevance_threshold": 0.3,
    "enable_reranker": true,
    "enable_web_search": true,
    "enable_query_condensation": true,
    "enable_query_expansion": true,
    "enable_post_generation_review": false,
    "enable_faithfulness_check": false,
    "faithfulness_threshold": 0.4,
    "faithfulness_strict_only": true,
    "history_max_turns": 6,
    "reply_history_max_turns": 12,
    "web_max_chars": 4000,
    "web_result_k": 5,
    "fresh_news_keywords": [
      "aujourd'hui",
      "dernière",
      "mise à jour",
      "version",
      "PDG",
      "score",
      "match",
      "prix",
      "sortie",
      "release",
      "2024",
      "2025",
      "actualité",
      "breaking"
    ]
  },
  "timeouts": {
    "llm_sec": 18,
    "web_sec": 8,
    "web_http_sec": 30,
    "math_sec": 8
  },
  "rate_limit": {
    "max_req": 50,
    "per_sec": 10
  },
  "llm": {
    "provider": "mistral",
    "model": "mistral-small-latest",
    "temperature": 0.6,
    "strict_temperature": 0.45,
    "top_p": 0.9,
    "strict_top_p": 1.0,
    "max_tokens": 1200,
    "roleplay_temperature": 0.9,
    "roleplay_max_tokens": 220,
    "smalltalk_temperature": 0.65,
    "smalltalk_max_tokens": 200,
    "http_timeout_sec": 60
  }
}
